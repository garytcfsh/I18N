<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800"
        x:Name="root">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5, 0"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
    </Window.Resources>
    
    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Text="I18N Converter - Guided Steps"/>

        <GroupBox Grid.Row="1" Header="Step 1. Open xlsx" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Open File"
                            MinWidth="110"
                            Click="OnBrowseClicked"/>
                    <TextBlock Grid.Column="1"
                               Margin="12,4,0,0"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="{Binding ElementName=root, Path=SourceFilePath}"/>
                </Grid>

                <TextBlock Margin="5,6,0,0" Foreground="#666"
                           Text="Format reference: Example/example.xlsx"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Step 2. Enter key name" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="0,4,8,0" Text="Key header:"/>
                <TextBox Grid.Column="1"
                         Text="{Binding ElementName=root, Path=PreferredKeyHeader, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Step 3. Convert file" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                <Button Content="Convert to Xcode"
                        MinWidth="140"
                        Click="On2XCodeClicked"/>
                <Button Content="Convert to txt(s)"
                        MinWidth="120"
                        Click="OnToTxtClicked"/>
                </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,4,0,0"
                    Visibility="{Binding ElementName=root, Path=IsConverting, Converter={StaticResource BoolToVis}}">
                <ProgressBar Width="130" Height="14" IsIndeterminate="True"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Converting..."/>
            </StackPanel>
                <TextBlock Margin="5,4,0,0" Foreground="#666"
                           Text="txt(s) is useful for quick per-language review, diff checks, or sharing with non-iOS teams."/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4" Margin="2,0,0,2" Foreground="#666"
                   Text="Tip: for this file, use KEY iOS GTB as key name."/>

        <GroupBox Grid.Row="5" Header="Status">
            <TextBlock Margin="8"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=root, Path=ErrMsg}"/>
        </GroupBox>
    </Grid>
</Window>
